# Environment Configuration for AI Customer Support Agent
# Optional: Set your OpenAI, Gemini, or Groq API key for dynamic LLM response generation and LLM-as-a-judge evaluation.
# If left unset, the system uses the high-quality deterministic offline generator and heuristic judge.

OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# LLM Model Configuration
LLM_PROVIDER=offline   # Options: 'offline', 'openai', 'gemini', 'groq'
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Pipeline Settings
RANDOM_SEED=42
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=3
CONFIDENCE_THRESHOLD=0.65
SIMILARITY_THRESHOLD=0.55
